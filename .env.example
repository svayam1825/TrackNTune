# Copy this file to .env and fill in your own values

# Local MongoDB:
MONGODB_URI=mongodb://127.0.0.1:27017/vehicle-tracker

# OR MongoDB Atlas (cloud, free tier):
# MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/vehicle-tracker

PORT=5000

# Optional: enables live Gemini responses in the AI Mechanic.
# If omitted, the app uses its built-in offline automotive knowledge responses.
GEMINI_API_KEY=
